<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Layar peluncuran (muncul sebelum WebView siap).

         SENGAJA warna polos, bukan @drawable/splash: layar ini tampil
         SEBELUM satu baris JS pun berjalan, jadi mustahil tahu apakah
         member sudah login. Artwork splash penuh membuatnya terbaca
         sebagai "animasi pembuka" padahal member yang sudah login
         seharusnya langsung mendarat di Beranda.

         Tidak ada @capacitor/splash-screen terpasang, jadi TIDAK ada
         penundaan buatan — layar ini hilang begitu WebView menggambar.
         JANGAN menambahkan launchShowDuration tanpa alasan kuat.

         Splash BERANIMASI tetap ada, tapi di sisi web (auth.html) dan
         hanya untuk member yang belum login. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splashBackground</item>
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <!-- LOGO DikaPay di layar peluncuran (Android 12+).

             Latar tetap WARNA POLOS seperti sebelumnya — yang ditambahkan
             cuma ikon di tengahnya, bukan artwork satu layar penuh. Jadi
             alasan lama tetap terjaga: layar ini tidak terbaca sebagai
             "animasi pembuka", dan tidak ada penundaan buatan (tetap TIDAK
             ada @capacitor/splash-screen, tetap tanpa launchShowDuration).

             Ikonnya DIPOTONG JADI LINGKARAN oleh sistem dan hanya bagian
             dalamnya yang terjamin terlihat, jadi splash_icon.png sengaja
             dibuat berpadding (logo ±62% dari sisi kanvas). Jangan diganti
             gambar yang memenuhi kanvas — sudutnya akan terpotong.

             Android 11 ke bawah tidak mengenal atribut ini dan tetap
             menampilkan warna polos; itu perilaku lama yang memang sudah
             berlaku di sana. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>